{% extends "base.html.j2" %}

{% block content %}

<div>
    <div class="min-h-screen">
        {% if songs is defined and songs is not none %}
            {% include "search-list.html.j2" %}
        {% else %}
        <span id="search-list" class="hero-content">
            <button class="btn btn-sm btn-ghost" data-on-load="@get('/client/search?q={{ (search_term or '')|urlencode }}')">
                <span class="loading loading-spinner">
                </span>
                LOADING
            </button>
        </span>
        {% endif %}
    </div>
</div>


{% endblock content %}